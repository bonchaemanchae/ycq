# Copy to .env and change the passwords. .env is git-ignored.
POSTGRES_DB=ycq
POSTGRES_USER=ycq
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

MONGO_USER=ycq
MONGO_PASSWORD=change-me
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ycq
# The API's own MongoDB login (read/write on the ycq database only). The
# loader creates it; the loader and tests use MONGO_USER (root) above.
MONGO_APP_USER=ycq_app
MONGO_APP_PASSWORD=change-me-app

JWT_SECRET=change-me

# Months the loader imports. One month is quicker for a first try.
YCQ_MONTHS=2026-01 2026-02 2026-03
# 0 = use the files already in data/ instead of downloading
YCQ_DOWNLOAD=1
API_PORT=8000
WEB_PORT=8080

# Remove the # to make every `docker compose` command use dev mode
# (macOS/Linux: use : instead of ;). See "Normal mode and dev mode" in README.
# COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
