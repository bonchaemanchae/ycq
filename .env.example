# Copy to .env and replace every change-me value. .env is git-ignored.
POSTGRES_DB=ycq
POSTGRES_USER=ycq
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# The API's own PostgreSQL login: reads everything, writes only users and
# plans (sql/015). The loader creates it; the loader and tests use
# POSTGRES_USER (the owner) above.
POSTGRES_APP_USER=ycq_app
POSTGRES_APP_PASSWORD=change-me-app

MONGO_USER=ycq
MONGO_PASSWORD=change-me
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ycq
# The API's own MongoDB login: reads the ycq database, writes only saved views
# (role ycqApp). The loader creates it; the loader and tests use MONGO_USER
# (root) above.
MONGO_APP_USER=ycq_app
MONGO_APP_PASSWORD=change-me-app

# Signs login tokens. The api refuses to start unless it is at least 32
# characters. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me

# Passwords for the default accounts, created by the loader (at least 12
# characters). Log in as admin@ycq.local, analyst1@ycq.local, analyst2@ycq.local.
# Leave one empty to not create that account.
YCQ_ADMIN_PASSWORD=change-me
YCQ_ANALYST1_PASSWORD=change-me
YCQ_ANALYST2_PASSWORD=change-me

# Months the loader imports. One month is quicker for a first try.
YCQ_MONTHS=2026-01 2026-02 2026-03
# 0 = use the files already in data/ instead of downloading
YCQ_DOWNLOAD=1
API_PORT=8000
WEB_PORT=8080

# Remove the # to make every `docker compose` command use dev mode
# (macOS/Linux: use : instead of ;). See "Normal mode and dev mode" in README.
# COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
